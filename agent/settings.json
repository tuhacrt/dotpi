{
  "defaultModel": "glm-5.3-flash",
  "defaultProvider": "polymer-aigw",
  "defaultThinkingLevel": "high",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "kiro/auto",
    "kiro/claude-opus-5",
    "kiro/claude-sonnet-5",
    "kiro/claude-fable-5.1",
    "polymer-aigw/glm-5.3-flash",
    "polymer-aigw/gpt-6-astra",
    "polymer-aigw/glm-5.3-flash"
  ],
  "fullscreenScrollbar": "always",
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.86.1",
  "packages": [
    "npm:context-mode",
    "npm:pi-footer",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:pi-rtk-optimizer",
    "npm:pi-mcp-adapter",
    "npm:@ff-labs/pi-fff",
    "npm:pi-subagents"
  ],
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "polymer-aigw/glm-5.3-flash",
        "thinking": "max"
      },
      "delegate": {
        "model": "polymer-aigw/glm-5.3-flash",
        "thinking": "max"
      },
      "oracle": {
        "model": "kiro/claude-opus-5",
        "thinking": "high"
      },
      "planner": {
        "model": "kiro/claude-opus-5",
        "thinking": "high"
      },
      "researcher": {
        "model": "kiro/claude-opus-5",
        "thinking": "high"
      },
      "reviewer": {
        "model": "kiro/claude-opus-5",
        "thinking": "high"
      },
      "scout": {
        "model": "polymer-aigw/glm-5.3-flash",
        "thinking": "max"
      },
      "worker": {
        "model": "polymer-aigw/glm-5.3-flash",
        "thinking": "max"
      }
    }
  },
  "terminal": {
    "clearOnShrink": true,
    "showTerminalProgress": true
  },
  "theme": "dark",
  "tuiMode": "regular"
}