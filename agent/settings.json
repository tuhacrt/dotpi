{
  "defaultModel": "claude-opus-5.5",
  "defaultProvider": "kiro",
  "defaultThinkingLevel": "high",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "kiro/auto",
    "kiro/claude-opus-5.5",
    "kiro/claude-sonnet-5",
    "kiro/gpt-5.6-luna",
    "polymer-aigw/glm-5.3-flash",
    "polymer-aigw/gpt-5.6-luna",
    "polymer-aigw/gpt-6-astra"
  ],
  "fullscreenScrollbar": "always",
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.99.2",
  "packages": [
    "npm:context-mode",
    "npm:pi-footer",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:pi-rtk-optimizer",
    "npm:@ff-labs/pi-fff",
    "npm:pi-subagents"
  ],
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "kiro/claude-opus-5.5",
        "thinking": "high"
      },
      "delegate": {
        "model": "polymer-aigw/gpt-5.6-luna",
        "thinking": "high"
      },
      "oracle": {
        "model": "polymer-aigw/gpt-5.6-luna",
        "thinking": "high"
      },
      "planner": {
        "model": "kiro/claude-opus-5.5",
        "thinking": "high"
      },
      "researcher": {
        "model": "kiro/claude-opus-5.5",
        "thinking": "high"
      },
      "reviewer": {
        "model": "kiro/claude-opus-5.5",
        "thinking": "high"
      },
      "scout": {
        "model": "polymer-aigw/gpt-5.6-luna",
        "thinking": "high"
      },
      "worker": {
        "model": "polymer-aigw/gpt-5.6-luna",
        "thinking": "high"
      }
    }
  },
  "terminal": {
    "clearOnShrink": true,
    "showTerminalProgress": true
  },
  "theme": "dark",
  "tuiMode": "regular"
}
