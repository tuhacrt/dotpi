{
  "defaultModel": "claude-sonnet-5",
  "defaultProvider": "kiro",
  "defaultThinkingLevel": "high",
  "fullscreenScrollbar": "always",
  "lastChangelogVersion": "0.84.0",
  "packages": [
    "npm:context-mode",
    "npm:pi-footer",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:pi-rtk-optimizer",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:@ff-labs/pi-fff"
  ],
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": "kiro/claude-opus-5",
        "thinking": "high"
      },
      "delegate": {
        "model": "kiro/claude-sonnet-5",
        "thinking": "medium"
      },
      "oracle": {
        "model": "kiro/claude-opus-5",
        "thinking": "high"
      },
      "planner": {
        "model": "kiro/claude-sonnet-5",
        "thinking": "high"
      },
      "researcher": {
        "model": "kiro/claude-opus-5",
        "thinking": "high"
      },
      "reviewer": {
        "model": "kiro/claude-opus-5",
        "thinking": "high"
      },
      "scout": {
        "model": "kiro/claude-sonnet-5",
        "thinking": "medium"
      },
      "worker": {
        "model": "kiro/claude-sonnet-5",
        "thinking": "medium"
      }
    }
  },
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true
  },
  "theme": "dark",
  "tuiMode": "regular",
  "enableInstallTelemetry": false,
  "enabledModels": [
    "kiro/auto",
    "kiro/claude-opus-5",
    "kiro/claude-sonnet-5",
    "kiro/gpt-5.6-luna",
    "kiro/gpt-5.6-sol"
  ]
}